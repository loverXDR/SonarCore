# --- LLM API ---
LLM_API_BASE=https://api.openai.com/v1/
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# --- HuggingFace ---
# Required for pyannote diarization
HF_TOKEN=your_huggingface_token_here

# --- ASR backend: whisper | qwen ---
ASR_BACKEND=whisper

# --- ASR (Faster-Whisper) ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# WHISPER_LANG=ru
# WHISPER_TASK=transcribe
# WHISPER_CPU_THREADS=0
# WHISPER_NUM_WORKERS=1
# WHISPER_DOWNLOAD_ROOT=
# WHISPER_PROMPT=
# WHISPER_HOTWORDS=
# WHISPER_MAX_NEW_TOKENS=
# WHISPER_CONDITION_ON_PREV=true
# WHISPER_VAD_FILTER=false
# Enable for word-level speaker assignment in diarization
# WHISPER_WORD_TIMESTAMPS=false

# --- ASR (Qwen3-ASR, requires: pip install -e .[qwen]) ---
# QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# QWEN_ASR_DEVICE=cpu
# QWEN_ASR_DTYPE=float32
# QWEN_ASR_ATTN=flash_attention_2
# QWEN_ASR_MAX_NEW_TOKENS=4096
# QWEN_ASR_BATCH_SIZE=8
# QWEN_ASR_LANG=ru
# QWEN_ASR_PROMPT=
# Empty value disables timestamps (segments are required for diarization)
# QWEN_ASR_ALIGNER=Qwen/Qwen3-ForcedAligner-0.6B
# QWEN_ASR_SEGMENT_GAP=0.8

# --- Diarization backend: none | pyannote | nemotron ---
DIARIZATION_BACKEND=none

# --- Nemotron 3 Diarization (pip install -e .[nemotron]) ---
# NEMOTRON_DIAR_MODEL=nvidia/Nemotron-3-Diarization
# NEMOTRON_DIAR_DEVICE=cpu
# bfloat16 for cuda
# NEMOTRON_DIAR_DTYPE=float32
# NEMOTRON_DIAR_THRESHOLD=0.5

# --- RAG / Indexing ---
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=32
EMBED_MODEL_NAME=intfloat/multilingual-e5-small
EMBED_DEVICE=cpu

# --- Vector DB (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=SonarPlace
